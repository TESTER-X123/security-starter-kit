{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "korean",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(python -m http.server *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(curl * --data *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys; data=json.load(sys.stdin); path=data.get('tool_input', {}).get('file_path', ''); blocked=['.env', 'secrets/', '.pem', '.key']; sys.exit(2 if any(b in path for b in blocked) else 0)\""
          }
        ]
      }
    ]
  }
}
